{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doodlewood-games",
  "main": "worker.js",
  "compatibility_date": "2026-07-31",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Without this, a request matching a file on disk is served straight from
    // the asset server and worker.js never runs, so the www redirect only
    // fired on URLs that happened to match nothing.
    "run_worker_first": true
  }
}
